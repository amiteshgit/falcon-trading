# ── Data provider ─────────────────────────────────────────────
# "mock" = runs with realistic sample data, no credentials needed.
# "kite" = live Zerodha data (requires the keys below).
DATA_PROVIDER=mock

# ── Kite Connect (only needed when DATA_PROVIDER=kite) ─────────
# Create an app at https://kite.trade to get these.
KITE_API_KEY=
KITE_API_SECRET=
# The Redirect URL you set in your Kite app must EXACTLY match this.
#   local:  http://127.0.0.1:3000/api/kite/callback
#   vercel: https://<your-app>.vercel.app/api/kite/callback
KITE_REDIRECT_URL=http://127.0.0.1:3000/api/kite/callback

# Capital assumption used for position sizing (safe to expose)
NEXT_PUBLIC_CAPITAL=50000

# ── Optional: Basic-Auth gate for a public deployment ─────────
# Set BOTH to require a username/password before the app loads. Leave blank to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
