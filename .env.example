# ── Data provider ─────────────────────────────────────────────
# "mock" = runs with realistic sample data, no credentials needed.
# "kite" = live Zerodha data (requires the keys below).
DATA_PROVIDER=mock

# ── Kite Connect (only needed when DATA_PROVIDER=kite) ─────────
# Create an app at https://kite.trade to get these.
# NEVER prefix these with NEXT_PUBLIC_ — that would ship them to the browser.
KITE_API_KEY=
KITE_API_SECRET=
# The Redirect URL you set in your Kite app must EXACTLY match this.
#   local:  http://127.0.0.1:3000/api/kite/callback
#   vercel: https://<your-app>.vercel.app/api/kite/callback
# Kite allows ONE redirect URL per app, so local and prod can't both be live at once.
KITE_REDIRECT_URL=http://127.0.0.1:3000/api/kite/callback

# Capital assumption used for position sizing (safe to expose)
NEXT_PUBLIC_CAPITAL=50000

# ── Order placement (SEBI static-IP rule, in force since 2026-04-01) ──
# Zerodha validates ORDER endpoints against a static IP registered on your Kite
# developer profile. Read endpoints (quotes, LTP, historical, holdings, positions)
# are NOT IP-checked and work from anywhere — so a Vercel deploy is fully usable
# read-only. Leave TRADING_ENABLED unset there: serverless egress IPs rotate, so
# orders would be rejected anyway, and an off switch means a public URL can't fire
# real orders.
#
# Set to "true" ONLY where requests leave via an IP you whitelisted at
# https://developers.kite.trade (profile → IP Whitelist; one change per week).
TRADING_ENABLED=

# Optional: route ONLY order calls through a static-IP proxy, so they egress from a
# whitelisted address while read calls still go direct. Whitelist the proxy's IP.
#   self-hosted (cheapest):  http://user:pass@<your-vps-ip>:3128
#   QuotaGuard:              http://user:pass@<host>:9293
# Prefer a proxy that tunnels HTTPS via CONNECT (no TLS termination) — order traffic
# carries your Kite access token.
KITE_PROXY_URL=

# ── Optional: Basic-Auth gate for a public deployment ─────────
# Set BOTH to require a username/password before the app loads. Leave blank to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Optional: bearer token for the MCP endpoint. middleware.ts exempts /api/mcp from
# Basic-Auth (a connector can't answer a browser prompt), so on a public deployment
# this is the one unauthenticated surface — set a long random value there.
MCP_AUTH_TOKEN=

# Opt-in ONLY for a self-hosted single-user box (e.g. your own VPS): lets the
# server-side token store act as an auth fallback so the MCP endpoint can use your
# live session. Never set this on shared/serverless hosting — a warm instance would
# hand your Kite session to any anonymous visitor.
ALLOW_SHARED_TOKEN_STORE=
